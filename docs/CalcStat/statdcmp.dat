' Support functions for CalcStat. These consist of implementations of more complex calculation types, decode methods for parameter "C" and rounding/min/max/compare functions for floating point numbers.

' ****************** Calculation Type support functions ******************

' DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD
' DataTableValue: Takes a value from an array table.

Function DataTableValue(ByVal vDataArray As Variant, ByVal dIndex As Double) As Variant

	Dim iIndex As Integer: iIndex = RoundDbl(dIndex)
	If iIndex <= 1% Then DataTableValue = vDataArray(0): Exit Function
	If iIndex > UBound(vDataArray) Then DataTableValue = vDataArray(UBound(vDataArray)): Exit Function
	DataTableValue = vDataArray(iIndex-1%)

End Function

' EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE
' ExpFmod: Exponential function based on percentage.
' Common percentage values are around ~5.5% for between levels and ~20% jumps between level segments.

Function ExpFmod(ByVal dVal As Double, ByVal dLstart As Double, ByVal dPlvl As Double, ByVal dLvl As Double, Optional ByVal vAdd As Variant, Optional ByVal vDec As Variant) As Double

	Dim dRng As Double: dRng = dLvl-dLstart+1#
	If dRng <= 0# Then ExpFmod = dVal: Exit Function
	
	Dim dFac As Double: dFac = 1#+dPlvl/100#
	
	Dim dAdd As Double: dAdd = 0#
	If Not IsMissing(vAdd) Then	dAdd = vAdd

	If IsMissing(vDec) Then
		Dim dFacExp As Double: dFacExp = dFac ^dRng
		ExpFmod = dVal*dFacExp+dAdd*((dFacExp-1#)/(dFac-1#))
		Exit Function
	End If

	Dim dResult As Double: dResult = dVal
	Dim dL As Double: dL = dLstart
	While dL <= dLvl
		dResult = RoundDbl(dResult*dFac+dAdd,vDec)
		dL = dL+1#
	Wend
	ExpFmod = dResult

End Function

' IIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIII
' LinInter: Linear Interpolation, given simple graph point data {{levels},{values}}

Function LinInter(ByVal dProgGraph As Variant, ByVal dLvl As Double) As Double

	' parameter processing
	Dim dLevels: dLevels = dProgGraph(0%)
	Dim dValues: dValues = dProgGraph(1%)
	
	' find interval points for requested level
	Dim iHigh As Integer: iHigh = LBound(dLevels)+1%
	Dim iMax As Integer: iMax = UBound(dLevels)
	Do While iHigh < iMax And dLvl > dLevels(iHigh)
		iHigh = iHigh+1%
	Loop
	Dim iLow As Integer: iLow = iHigh-1%

	' return interpolated value from the interval graph points
	LinInter = LinFmod(1#,dValues(iLow),dValues(iHigh),dLevels(iLow),dLevels(iHigh),dLvl)

End Function

' PPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPP
' CalcPercAB: Calculates the percentage out of a rating based on the AB formula.

Function CalcPercAB(ByVal dA As Double, ByVal dB As Double, ByVal dPCap As Double, ByVal dR As Double) As Double

	If dR <= 0# Then CalcPercAB = 0#: Exit Function
	Dim dResult As Double: dResult = dA/(1#+dB/dR)
	If dResult >= dPCap Then CalcPercAB = dPCap: Exit Function
	CalcPercAB = dResult

End Function

' RRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR
' CalcRatAB: Calculates the rating out of a percentage based on the AB formula.

Function CalcRatAB(ByVal dA As Double, ByVal dB As Double, ByVal dCapR As Double, ByVal dP As Double) As Double

	If dP <= 0# Then CalcRatAB = 0#: Exit Function
	Dim dResult As Double: dResult = dB/(dA/dP-1#)
	If dResult >= dCapR Then CalcRatAB = dCapR: Exit Function
	CalcRatAB = dResult

End Function

' SSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSS
' StatLinInter: (Normalized) Stat Linear Interpolating

Function StatLinInter(ByVal sPntMP As String, ByVal sProgScheme As String, ByVal sProgBase As String, ByVal sAdj As String, ByVal dLvl As Double, ByVal vNorC As Variant, Optional ByVal vRoundType As Variant) As Double

	' parameter processing
	Dim dN As Double: dN = 1#
	Dim sC As String: sC = ""
	If IsNumeric(vNorC) Then
		dN = vNorC
	ElseIf VarType(vNorC) = 8 Then
		sC = vNorC
	End If

	Dim dProgScheme: dProgScheme = CalcStat(sProgScheme,dLvl)
	Dim dAccessLvls: dAccessLvls = dProgScheme(0%)
	Dim dBaseLvls: dBaseLvls = dProgScheme(1%)
	
	' find interval points for requested level
	Dim iHigh As Integer: iHigh = LBound(dAccessLvls)+1%
	Dim iMax As Integer: iMax = UBound(dAccessLvls)
	Do While iHigh < iMax And dLvl > dAccessLvls(iHigh)
		iHigh = iHigh+1%
	Loop
	Dim iLow As Integer: iLow = iHigh-1%

	Dim dAccessLvlLow As Double: dAccessLvlLow = dAccessLvls(iLow)
	Dim dAccessLvlHigh As Double: dAccessLvlHigh = dAccessLvls(iHigh)
	
	Dim dValLow As Double, dValHigh As Double
	If sProgBase = "" Then
		' if not given: expect the base levels to contain the values directly
		dValLow = dBaseLvls(iLow)
		dValHigh = dBaseLvls(iHigh)
	Else
		' get values from base progression if given
		dValLow = CalcStat(sProgBase,dBaseLvls(iLow),sC)
		dValHigh = CalcStat(sProgBase,dBaseLvls(iHigh),sC)
	End If

	' graph point multiplications
	If sPntMP <> "" Then
		dValLow = dValLow*CalcStat(sPntMP,dAccessLvlLow,sC)
		dValHigh = dValHigh*CalcStat(sPntMP,dAccessLvlHigh,sC)
	End If
	If sAdj <> "" Then
		dValLow = dValLow*CalcStat(sAdj,dAccessLvlLow,sC)
		dValHigh = dValHigh*CalcStat(sAdj,dAccessLvlHigh,sC)
	End If

	' return interpolated value from the calculated graph points
	StatLinInter = LinFmod(dN,dValLow,dValHigh,dAccessLvlLow,dAccessLvlHigh,dLvl,vRoundType)

End Function

' TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT
' LinFmod: Linear line function between 2 points with some optional modifications.
' Connects point (dLstart,dVal*dFstart) with (dLend,dVal*dFend).
' Usually used with dVal=1 and dFstart/dFend containing unrelated points or dVal=base and dFstart/dFend containing multiplier factors.
' Modification for points: rounding.

Function LinFmod(ByVal dVal As Double, ByVal dFstart As Double, ByVal dFend As Double, ByVal dLstart As Double, ByVal dLend As Double, ByVal dLvl As Double, Optional ByVal vRoundType As Variant) As Double

	Dim iRoundType As Integer: iRoundType = 0%
	If Not IsMissing(vRoundType) Then iRoundType = vRoundType
	
	' finalize interval values: multiply base Value by Factor and apply rounding by requested type
	Dim dVstart As Double: dVstart = dVal*dFstart
	Dim dVend As Double: dVend = dVal*dFend
	Select Case iRoundType
		Case 1%
			dVstart = RoundDblProg(dVstart)
			dVend = RoundDblProg(dVend)
		Case 2%
			dVstart = RoundDblLotro(dVstart)
			dVend = RoundDblLotro(dVend)
		Case 3%
			dVstart = RoundDblMorReg(dVstart)
			dVend = RoundDblMorReg(dVend)
	End Select

	' return point value directly if requested level is a low/high interval point
	If dLvl = dLstart Then LinFmod = dVstart: Exit Function
	If dLvl = dLend Then LinFmod = dVend: Exit Function

	If dLstart = dLend Then LinFmod = 0#: Exit Function 'can't interpolate, return 0

	'return interpolated value from the calculated graph points
	LinFmod = (dVstart*(dLend-dLvl)+(dLvl-dLstart)*dVend)/(dLend-dLstart)

End Function

' VVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVV
' TranslateValue: translates a value to an other by using a lookup table and a result table.
' If the value is not found in the lookup table then the function returns the default value, which is the last element in the result table.
' Object types allowed are both numbers (doubles, integers) and strings (non case sensitive matching) and may be mixed.

Function TranslateValue(ByVal vSourceData As Variant, ByVal vResultData As Variant, ByVal vSearch As Variant) As Variant

	Dim iSrc As Integer: iSrc = 0
	If IsNumeric(vSearch) Then
		For Each vSrc In vSourceData
			If IsNumeric(vSrc) Then If vSrc = vSearch Then TranslateValue = vResultData(iSrc): Exit Function
			iSrc = iSrc+1%
		Next
	ElseIf VarType(vSearch) = 8 Then
		Dim sSearch As String: sSearch = UCase(Trim(vSearch))
		For Each vSrc In vSourceData
			If VarType(vSrc) = 8 Then If vSrc = sSearch Then TranslateValue = vResultData(iSrc): Exit Function
			iSrc = iSrc+1%
		Next
	End If

	TranslateValue = vResultData(UBound(vResultData)) ' return default value

End Function

' ****************** Parameter "C" decode support functions ******************

' ArmCodeIndex: returns a specified index from an Armour Code.
' sACode string:
' 1st position: H=heavy, M=medium, L=light
' 2nd position: H=head, S=shoulders, CL=cloak/back, C=chest, G=gloves, L=leggings, B=boots, Sh=shield
' 3rd position: W=white/common, Y=yellow/uncommon, P=purple/rare, T=teal/blue/incomparable, G=gold/legendary/epic
' Note: no such thing exists as a heavy, medium or light cloak, so no H/M/L in cloak codes (cloaks go automatically in the M class since U23, although historically this was L)

Function ArmCodeIndex(ByVal sACode As String, ByVal iI As Integer) As Integer

	Dim sArmCode As String:	sArmCode = UCase(Trim(sACode))
	If sArmCode = "" Then ArmCodeIndex = 0%: Exit Function
	
	Dim sArmCat As String: sArmCat = Left(sArmCode,1)
	Dim sArmType As String: sArmType = Mid(sArmCode,2,1)
	Dim sArmCol As String: sArmCol = Mid(sArmCode,3,1)
	
	If sArmType = "S" AND sArmCol = "H" Then
		sArmType = "SH"
		sArmCol = Mid(sArmCode,4,1)
	ElseIf sArmCat = "C" AND sArmType = "L" Then
		sArmCat = "M"
		sArmType = "CL"
	Else
		sArmType = " "+sArmType
	End If
	
	Select Case iI
		Case 1%
			ArmCodeIndex = InStr("HML",sArmCat)
		Case 2%
			ArmCodeIndex = (InStr(" H SCL C G L BSH",sArmType)+1%)/2%
		Case 3%
			ArmCodeIndex = InStr("WYPTG",sArmCol)
		Case Else
			ArmCodeIndex = 0%
	End Select
	
End Function

' EnumIndex: returns an index in a Enum string for a character at a specified index in a Code string
' returns 0 for unknown or missing character

Function EnumIndex(ByVal sCodeChars As String, ByVal iCodeIndex As Integer, ByVal sEnumChars As String) As Integer

	Dim sCode As String: sCode = UCase(Trim(sCodeChars))
	If sCode = "" Then EnumIndex = 0%: Exit Function ' no code given

	Dim sChar As String: sChar = Mid(sCode,iCodeIndex,1)
	If sChar = "" Then EnumIndex = 0%: Exit Function ' no character found at specified index

	EnumIndex = InStr(sEnumChars,sChar) ' returns index of char in Enum string or 0 if not found
	
End Function

' RomanRankDecode: converts a string with a Roman number in characters, to an integer number.
' used for Legendary Item Title calculation.

Function RomanRankDecode(ByVal sRCode As String) As Integer

	Dim sRomanCode As String: sRomanCode = UCase(Trim(sRCode))
	If sRomanCode = "" Then RomanRankDecode = 0%: Exit Function

	Static sRomanRankChars As Variant: If IsEmpty(sRomanRankChars) Then sRomanRankChars = Array("M","CM","D","CD","C","XC","L","XL","X","IX","V","IV","I")
	Static iRomanRankValues As Variant: If IsEmpty(iRomanRankValues) Then iRomanRankValues = Array(1000%,900%,500%,400%,100%,90%,50%,40%,10%,9%,5%,4%,1%)

	Dim iValue As Integer: iValue = 0%

	Dim iCharFound As Integer
	Dim iCharLen As Integer

	Dim C As Integer: C = 1%
	Dim iCodeLen As Integer: iCodeLen = Len(sRomanCode)
	Do While C <= iCodeLen
		iCharFound = -1%
		For I = 0% To 12%
			iCharLen = 1% + I Mod 2%
			If C+iCharLen-1% <= iCodeLen Then If Mid(sRomanCode,C,iCharLen) = sRomanRankChars(I) Then iCharFound = I: Exit For
		Next
		If iCharFound = -1% Then Exit Do ' found unknown character: terminate
		iValue = iValue+iRomanRankValues(iCharFound)
		C = C + iCharLen
	Loop
	
	RomanRankDecode = iValue

End Function

' ****************** Misc. floating point support functions ******************

' Misc. functions for floating point rounding.
' 2nd parameter is number of decimals.

Function CorrectDbl(ByVal dNum As Double, ByVal dCorrection As Double, ByVal dDec As Double) As Double

	If dNum = 0# Then CorrectDbl = dNum: Exit Function

	Dim dSignedCorrection As Double
	If dNum < 0# Then dSignedCorrection = -dCorrection Else dSignedCorrection = dCorrection

	If dDec = 0# Then CorrectDbl = Fix(dNum+dSignedCorrection): Exit Function

	Dim dFactor As Double: dFactor = 10 ^dDec
	CorrectDbl = Fix(dNum*dFactor+dSignedCorrection)/dFactor

End Function

Function RoundDbl(ByVal dNum As Double, Optional ByVal vDec As Variant) As Double

	If IsMissing(vDec) Then RoundDbl = CorrectDbl(dNum,DblCorrNormal,0#): Exit Function
	RoundDbl = CorrectDbl(dNum,DblCorrNormal,vDec)

End Function

Function RoundDblDown(ByVal dNum As Double, Optional ByVal vDec As Variant) As Double

	If IsMissing(vDec) Then RoundDblDown = CorrectDbl(dNum,DblCorrDown,0#): Exit Function
	RoundDblDown = CorrectDbl(dNum,DblCorrDown,vDec)

End Function

Function RoundDblUp(ByVal dNum As Double, Optional ByVal vDec As Variant) As Double

	If IsMissing(vDec) Then RoundDblUp = CorrectDbl(dNum,DblCorrUp,0#): Exit Function
	RoundDblUp = CorrectDbl(dNum,DblCorrUp,vDec)

End Function

Function RoundDblLotro(ByVal dNum As Double) As Double

	If 0# > dNum And dNum >= -2# Then RoundDblLotro = -2#: Exit Function
	Dim dAbsNum As Double: dAbsNum = Abs(dNum)
	If dAbsNum <= 1000# Then RoundDblLotro = CorrectDbl(dNum,DblCorrUp,0#): Exit Function
	RoundDblLotro = CorrectDbl(dNum,DblCorrUp,2%-Int(Log(dAbsNum)/DblLog10))

End Function

Function RoundDblMorReg(ByVal dNum As Double) As Double

	Dim dAbsNum As Double: dAbsNum = Abs(dNum)
	If dAbsNum <= 100# Then RoundDblMorReg = CorrectDbl(dNum,DblCorrUp,2#): Exit Function
	If dAbsNum <= 1000# Then RoundDblMorReg = CorrectDbl(dNum,DblCorrUp,1#): Exit Function
	RoundDblMorReg = CorrectDbl(dNum,DblCorrUp,2%-Int(Log(dAbsNum)/DblLog10))

End Function

Function RoundDblProg(ByVal dNum As Double) As Double

	If dNum = 0# Then RoundDblProg = dNum: Exit Function
	RoundDblProg = CorrectDbl(dNum,DblCorrNormal,2%-Int(Log(Abs(dNum))/DblLog10+0.5#))

End Function

' converts a double value into the equivalent of a single float value
Function EquSng(ByVal fVal As Single) As Double

	EquSng = fVal

End Function

' converts a double value into the decimal representation of an equivalent single float value
Function DecSng(ByVal vVal) As Double

	Dim dVal As Double: dVal = EquSng(vVal)
	If dVal = 0# Then DecSng = 0#: Exit Function ' return 0 when 0

	' calculate decimals interval for a max total of 8 digit precision
	' 0.09#######: 9 to 2
	' 0.9#######: 8 to 1
	' 9.#######: 7 to 0
	' 9#.######: 6 to -1
	' 9##.#####: 5 to -2 etc
	Dim iDecMin As Integer: iDecMin = 8%-(Int(Log(Abs(dVal))/DblLog10)+1%)
	Dim iDecMax As Integer: iDecMax = iDecMin-7%

	' result always needs to be rounded at least once, even if the result is not the same as the original equiv. float value
	Dim dResult As Double: dResult = CorrectDbl(dVal,DblCorrNormal,iDecMin)

	' search for the least number of decimals, while still keeping the same single value
	Dim dTest As Double
	Dim iDec As Integer
	For iDec = iDecMin-1% To iDecMax Step -1%
		dTest = CorrectDbl(dVal,DblCorrNormal,iDec) ' test value with ever less precision
		If dTest <> dResult Then
			If EquSng(dTest) = dVal Then
				dResult = dTest
			Else
				' (test)value contains no longer the same single value
				Exit For
			End If
		End If
	Next
	
	DecSng = dResult

End Function
