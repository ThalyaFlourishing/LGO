<?php
// Created by Giseldah

function CalcStat($SName, $SLvl, $SParam = NULL)
{
 	$SN = strtoupper(trim($SName));
	$L = $SLvl;
	$N = 1.0;
	$C = "";
	if (is_numeric($SParam))
		$N = $SParam;
	elseif (is_string($SParam))
		$C = $SParam;
	
	$Result = 0.0;

