	return $Result;
}

// Support functions for CalcStat. These consist of implementations of more complex calculation types, decode methods for parameter "C" and rounding/min/max/compare functions for floating point numbers.

// ****************** Calculation Type support functions ******************

// DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD
// DataTableValue: Takes a value from an array table.

function DataTableValue($vDataArray, $dIndex)
{
	$iIndex = RoundDbl($dIndex);
	return (($iIndex <= 1) ? $vDataArray[0] : (($iIndex >= count($vDataArray)) ? $vDataArray[count($vDataArray)-1] : $vDataArray[$iIndex-1]));
}

// EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE
// ExpFmod: Exponential function based on percentage.
// Common percentage values are around ~5.5% for between levels and ~20% jumps between level segments.

function ExpFmod($dVal, $dLstart, $dPlvl, $dLvl, $vAdd = NULL, $vDec = NULL)
{
	$dRng = $dLvl-$dLstart+1.0;
	if ($dRng <= 0.0) return $dVal;

	$dFac = 1.0+$dPlvl/100.0;

	$dAdd = is_numeric($vAdd) ? $vAdd : 0.0;

	if (!is_numeric($vDec)) {
		$dFacExp = pow($dFac,$dRng);
		return $dVal*$dFacExp+$dAdd*(($dFacExp-1.0)/($dFac-1.0));
	}

	$dResult = $dVal;
	$dL = $dLstart;
	while ($dL++ <= $dLvl)
		$dResult = RoundDbl($dResult*$dFac+$dAdd,$vDec);
	return $dResult;
}

// IIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIII
// LinInter: Linear Interpolation, given simple graph point data {{levels},{values}}

function LinInter($dProgGraph, $dLvl)
{
	// parameter processing
	$dLevels = $dProgGraph[0];
	$dValues = $dProgGraph[1];

	// find interval points for requested level
	$iHigh = 1;
	$iMax = count($dLevels)-1;
	while ($iHigh < $iMax and $dLvl > $dLevels[$iHigh])
		$iHigh++;
	$iLow = $iHigh-1;
		
	// return interpolated value from the interval graph points
	return LinFmod(1.0,$dValues[$iLow],$dValues[$iHigh],$dLevels[$iLow],$dLevels[$iHigh],$dLvl);
}

// PPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPP
// CalcPercAB: Calculates the percentage out of a rating based on the AB formula.

function CalcPercAB($dA, $dB, $dPCap, $dR)
{
	if ($dR <= 0.0) return 0.0;
	$dResult = $dA/(1.0+$dB/$dR);
	return ($dResult >= $dPCap) ? $dPCap : $dResult;
}

// RRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR
// CalcRatAB: Calculates the rating out of a percentage based on the AB formula.

function CalcRatAB($dA, $dB, $dCapR, $dP)
{
	if ($dP <= 0.0) return 0.0;
	$dResult = $dB/($dA/$dP-1.0);
	return ($dResult >= $dCapR) ? $dCapR : $dResult;
}

// SSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSS
// StatLinInter: (Normalized) Stat Linear Interpolating

function StatLinInter($sPntMP, $sProgScheme, $sProgBase, $sAdj, $dLvl, $vNorC, $vRoundType = NULL)
{
	// parameter processing
	$dN = 1.0;
	$sC = "";
	if (is_numeric($vNorC))
		$dN = $vNorC;
	elseif (is_string($vNorC))
		$sC = $vNorC;

	$dProgScheme = CalcStat($sProgScheme,$dLvl);
	$dAccessLvls = $dProgScheme[0];
	$dBaseLvls = $dProgScheme[1];

	// find interval points for requested level
	$iHigh = 1;
	$iMax = count($dAccessLvls)-1;
	while ($iHigh < $iMax and $dLvl > $dAccessLvls[$iHigh])
		$iHigh++;
	$iLow = $iHigh-1;
		
	$dAccessLvlLow = $dAccessLvls[$iLow];
	$dAccessLvlHigh = $dAccessLvls[$iHigh];
	
	if ($sProgBase == "") {
		// if not given: expect the base levels to contain the values directly
		$dValLow = $dBaseLvls[$iLow];
		$dValHigh = $dBaseLvls[$iHigh];
	} else {
		// get values from base progression if given
		$dValLow = CalcStat($sProgBase,$dBaseLvls[$iLow],$sC);
		$dValHigh = CalcStat($sProgBase,$dBaseLvls[$iHigh],$sC);
	}

	// graph point multiplications
	if ($sPntMP != "") {
		$dValLow *= CalcStat($sPntMP,$dAccessLvlLow,$sC);
		$dValHigh *= CalcStat($sPntMP,$dAccessLvlHigh,$sC);
	}
	if ($sAdj != "") {
		$dValLow *= CalcStat($sAdj,$dAccessLvlLow,$sC);
		$dValHigh *= CalcStat($sAdj,$dAccessLvlHigh,$sC);
	}

	// return interpolated value from the calculated graph points
	return LinFmod($dN,$dValLow,$dValHigh,$dAccessLvlLow,$dAccessLvlHigh,$dLvl,$vRoundType);
}

// TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT
// LinFmod: Linear line function between 2 points with some optional modifications.
// Connects point (dLstart,dVal*dFstart) with (dLend,dVal*dFend).
// Usually used with dVal=1 and dFstart/dFend containing unrelated points or dVal=base and dFstart/dFend containing multiplier factors.
// Modification for points: rounding.

// list of functions which are used for rounding graph point values
const fRoundTypes = [
	0 => 'RoundNone',
	1 => 'RoundDblProg',
	2 => 'RoundDblLotro',
	3 => 'RoundDblMorReg'
];

function RoundNone($dValue){return $dValue;} // no rounding function

function LinFmod($dVal, $dFstart, $dFend, $dLstart, $dLend, $dLvl, $vRoundType = NULL)
{
	// parameter processing
	$iRoundType = (is_numeric($vRoundType)) ? $vRoundType : 0;
	$fRound = fRoundTypes[$iRoundType];

	// finalize interval values: multiply base Value by Factor and apply rounding by requested type
	// return point value directly if requested level is a low/high interval point
	$dVstart = $fRound($dVal*$dFstart);
	if ($dLvl == $dLstart) return $dVstart;
	$dVend = $fRound($dVal*$dFend);
	if ($dLvl == $dLend) return $dVend;

	if ($dLstart == $dLend) return 0.0; // can't interpolate, return 0

	// return interpolated value from the calculated graph points
	return ($dVstart*($dLend-$dLvl)+($dLvl-$dLstart)*$dVend)/($dLend-$dLstart);
}

// VVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVV
// TranslateValue: translates a value to an other by using a lookup table and a result table.
// If the value is not found in the lookup table then the function returns the default value, which is the last element in the result table.
// Object types allowed are both numbers (doubles, integers) and strings (non case sensitive matching) and may be mixed.

function TranslateValue($vSourceData, $vResultData, $vSearch)
{
	$iSourceCount = count($vSourceData);
	if (is_numeric($vSearch))
		for ($iSrc = 0; $iSrc < $iSourceCount; $iSrc++) {
			$vSrc = $vSourceData[$iSrc];
			if (is_numeric($vSrc) and $vSrc == $vSearch) return $vResultData[$iSrc];
		}
	elseif (is_string($vSearch)) {
		$sSearch = strtoupper(trim($vSearch));
		for ($iSrc = 0; $iSrc < $iSourceCount; $iSrc++) {
			$vSrc = $vSourceData[$iSrc];
			if (is_string($vSrc) and $vSrc == $sSearch) return $vResultData[$iSrc];
		}
	}

	return $vResultData[count($vResultData)-1]; // return default value
}

// ****************** Parameter "C" decode support functions ******************

// ArmCodeIndex: returns a specified index from an Armour Code.
// sACode string:
// 1st position: H=heavy, M=medium, L=light
// 2nd position: H=head, S=shoulders, CL=cloak/back, C=chest, G=gloves, L=leggings, B=boots, Sh=shield
// 3rd position: W=white/common, Y=yellow/uncommon, P=purple/rare, T=teal/blue/incomparable, G=gold/legendary/epic
// Note: no such thing exists as a heavy, medium or light cloak, so no H/M/L in cloak codes (cloaks go automatically in the M class since U23, although historically this was L)

function ArmCodeIndex($sACode, $iI)
{
	$sArmCode = strtoupper(trim($sACode));
	if ($sArmCode == "") return 0;

	// get positional codes and make some corrections
	$sArmCat = substr($sArmCode,0,1);
	$sArmType = substr($sArmCode,1,1);
	$sArmCol = substr($sArmCode,2,1);

	if ($sArmType == "S" and $sArmCol == "H") {
		$sArmType = "SH";
		$sArmCol = substr($sArmCode,3,1);
	} elseif ($sArmCat == "C" and $sArmType == "L") {
		$sArmCat = "M";
		$sArmType = "CL";
	} else
		$sArmType = " ".$sArmType;
	
	switch ($iI) {
		case 1:
			$ind = strpos("HML",$sArmCat);
			return (($ind === false) ? 0 : $ind+1);
		case 2:
			$ind = strpos(" H SCL C G L BSH",$sArmType);
			return (($ind === false) ? 0 : ($ind/2)+1);
		case 3:
			$ind = strpos("WYPTG",$sArmCol);
			return (($ind === false) ? 0 : $ind+1);
		default:
			return 0;
	}
}

// EnumIndex: returns an index in a Enum string for a character at a specified index in a Code string
// returns 0 for unknown or missing character

function EnumIndex($sCodeChars, $iCodeIndex, $sEnumChars)
{
	$sCode = strtoupper(trim($sCodeChars));
	if ($sCode == "") return 0; // no code given

	$sChar = substr($sCode,$iCodeIndex-1,1);
	if ($sChar == "") return 0; // no character found at specified index
	
	$ind = strpos($sEnumChars,$sChar);
	return (($ind === false) ? 0 : $ind+1); // returns index of char in Enum string or 0 if not found
}

// RomanRankDecode: converts a string with a Roman number in characters, to an integer number.
// used for Legendary Item Title calculation.

const sRomanRankChars = array("M","CM","D","CD","C","XC","L","XL","X","IX","V","IV","I");
const iRomanRankValues = array(1000,900,500,400,100,90,50,40,10,9,5,4,1);

function RomanRankDecode($sRCode)
{
	$sRomanCode = strtoupper(trim($sRCode));
	if ($sRomanCode == "") return 0;

	$iValue = 0;

	$C = 0;
	$iCodeLen = strlen($sRomanCode);
	while ($C < $iCodeLen) {
		$iCharFound = NULL;
		for ($I = 0; $I <= 12; $I++) {
			$iCharLen = 1+$I%2;
			if ($C+$iCharLen-1 < $iCodeLen and substr($sRomanCode,$C,$iCharLen) == sRomanRankChars[$I]) {
				$iCharFound = $I;
				break;
			}
		}
		if (is_null($iCharFound)) break; // found unknown character: terminate
		$iValue += iRomanRankValues[$iCharFound];
		$C += $iCharLen;
	}

	return $iValue;
}

// ****************** Misc. floating point support functions ******************

// Misc. functions for floating point: rounding etc.
// For roundings: vDec is number of decimals.

// Floating point numbers bring errors into the calculation, both inside the Lotro-client and in this function collection. This is why a 100% match with the stats in Lotro is impossible.
// Anyway, to compensate for some errors, we use a calculation deviation correction value. This makes for instance 24.49999999 round to 25, as it's assumed that 24.5 was intended as outcome of a formula.
const DblCalcDev = 1e-8;
const DblCorrDown = DblCalcDev;
const DblCorrNormal = 0.5+DblCalcDev;
const DblCorrUp = 1.0-DblCalcDev;

function CorrectDbl($dNum, $dCorrection, $dDec)
{
	if ($dNum == 0.0) return $dNum;

	$dSignedCorrection = ($dNum < 0.0) ? -$dCorrection : $dCorrection;

	if ($dDec == 0.0) return intval($dNum+$dSignedCorrection);

	$dFactor = pow(10,$dDec);
	return intval($dNum*$dFactor+$dSignedCorrection)/$dFactor;
}

function RoundDbl($dNum, $vDec = NULL)
{
	
	return CorrectDbl($dNum,DblCorrNormal,(is_numeric($vDec)) ? $vDec : 0.0);
}

function RoundDblDown($dNum, $vDec = NULL)
{
	return CorrectDbl($dNum,DblCorrDown,(is_numeric($vDec)) ? $vDec : 0.0);
}

function RoundDblUp($dNum, $vDec = NULL)
{
	return CorrectDbl($dNum,DblCorrUp,(is_numeric($vDec)) ? $vDec : 0.0);
}

function RoundDblLotro($dNum)
{
	if ($dNum < 0.0 and $dNum > -2.0) return -2.0;
	$dAbsNum = abs($dNum);
	if ($dAbsNum <= 1000.0) return CorrectDbl($dNum,DblCorrUp,0.0);
	return CorrectDbl($dNum,DblCorrUp,2-floor(log10($dAbsNum)));
}

function RoundDblMorReg($dNum)
{
	$dAbsNum = abs($dNum);
	if ($dAbsNum <= 100.0) return CorrectDbl($dNum,DblCorrUp,2.0);
	if ($dAbsNum <= 1000.0) return CorrectDbl($dNum,DblCorrUp,1.0);
	return CorrectDbl($dNum,DblCorrUp,2-floor(log10($dAbsNum)));
}

function RoundDblProg($dNum)
{
	if ($dNum == 0.0) return $dNum;
	return CorrectDbl($dNum,DblCorrNormal,2-floor(log10(abs($dNum))+0.5));
}

// converts a double value into the equivalent of a single float value
function EquSng($vVal)
{
	return unpack("f",pack("f",$vVal))[1];
}

// converts a double value into the decimal representation of an equivalent single float value
function DecSng($vVal)
{
	$dVal = EquSng($vVal);
	if ($dVal == 0.0) return 0.0; // return 0 when 0

	// calculate decimals interval for a max total of 8 digit precision
	// 0.09#######: 9 to 2
	// 0.9#######: 8 to 1
	// 9.#######: 7 to 0
	// 9#.######: 6 to -1
	// 9##.#####: 5 to -2 etc
	$iDecMin = 8-(floor(log10(abs($dVal)))+1);
	$iDecMax = $iDecMin-7;
	// result always needs to be rounded at least once, even if the result is not the same as the original equiv. float value
	$dResult = CorrectDbl($dVal,DblCorrNormal,$iDecMin);
	// search for the least number of decimals, while still keeping the same single value
	for ($iDec = $iDecMin-1; $iDec >= $iDecMax; $iDec--) {
		$dTest = CorrectDbl($dVal,DblCorrNormal,$iDec); // test value with ever less precision
		if ($dTest != $dResult) {
			if (EquSng($dTest) == $dVal)
				$dResult = $dTest;
			else
				// (test)value contains no longer the same single value
				break;
		}
	}
	return $dResult;
}
