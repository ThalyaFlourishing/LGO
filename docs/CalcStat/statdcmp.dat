' Created by Giseldah

' Floating point numbers bring errors into the calculation, both inside the Lotro-client and in this function collection. This is why a 100% match with the stats in Lotro is impossible.
' Anyway, to compensate for some errors, we use a calculation deviation correction value. This makes for instance 24.49999999 round to 25, as it's assumed that 24.5 was intended as outcome of a formula.
Private Const DblCalcDev As Double = 1e-8#
Private Const DblCorrDown As Double = DblCalcDev
Private Const DblCorrNormal As Double = 0.5#+DblCalcDev
Private Const DblCorrUp As Double = 1#-DblCalcDev
Private Const DblLog10 As Double = 2.3025850929940456840179914546844#

16
Function CalcStat(ByVal SName As String, ByVal SLvl As Double, Optional SParam As Variant) As Variant

	Dim SN As String: SN = UCase(Trim(SName))
	Dim L As Double: L = SLvl
	Dim N As Double: N = 1#
	Dim C As String: C = ""
	If Not IsMissing(SParam) Then
		If IsNumeric(SParam) Then
			N = SParam
		ElseIf VarType(SParam) = 8 Then
			C = SParam
		End If
	End If
	
	Dim Result As Variant: Result = 0#

5

	CalcStat = Result

End Function

4
Private Function CalcStat$NODEID(ByVal SN As String, ByVal L As Double, ByVal N As Double, ByVal C As String) As Variant
	
	Dim Result As Variant: Result = 0#

5

	CalcStat$NODEID = Result

End Function

