    return Result

# Support defs for CalcStat. These consist of implementations of more complex calculation types, decode methods for parameter "C" and rounding/min/max/compare defs for floating point numbers.

# ****************** Calculation Type support defs ******************

# DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD
# DataTableValue: Takes a value from an array table.

def DataTableValue(vDataArray, dIndex):
    iIndex = RoundDbl(dIndex)
    return vDataArray[0] if iIndex <= 1 else vDataArray[-1] if iIndex >= len(vDataArray) else vDataArray[iIndex-1]

# EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE
# ExpFmod: Exponential function based on percentage.
# Common percentage values are around ~5.5% for between levels and ~20% jumps between level segments.

def ExpFmod(dVal, dLstart, dPlvl, dLvl, vAdd = 0, vDec = None):
    dRng = dLvl - dLstart + 1
    if dRng <= 0: return dVal

    dFac = 1 + dPlvl / 100
	
    if vDec is None:
        dFacExp = pow(dFac, dRng)
        return dVal * dFacExp + vAdd * ((dFacExp - 1) / (dFac - 1))

    dResult = dVal
    dL = dLstart
    while dL <= dLvl:
        dResult = RoundDbl(dResult * dFac + vAdd, vDec)
        dL += 1
    return dResult

# IIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIII
# LinInter: Linear Interpolation, given simple graph point data {{levels},{values}}

def LinInter(dProgGraph, dLvl):
    # parameter processing
    dLevels = dProgGraph[0]
    dValues = dProgGraph[1]

    # find interval points for requested level
    iHigh = 1
    iMax = len(dLevels) - 1
    while iHigh < iMax and dLvl > dLevels[iHigh]:
        iHigh += 1
    iLow = iHigh - 1

    # return interpolated value from the interval graph points
    return LinFmod(1, dValues[iLow], dValues[iHigh], dLevels[iLow], dLevels[iHigh], dLvl)

# PPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPP
# CalcPercAB: Calculates the percentage out of a rating based on the AB formula.

def CalcPercAB(dA, dB, dPCap, dR):
    if dR <= 0: return 0
    dResult = dA / (1 + dB / dR)
    return dPCap if dResult >= dPCap else dResult

# RRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR
# CalcRatAB: Calculates the rating out of a percentage based on the AB formula.

def CalcRatAB(dA, dB, dCapR, dP):
    if dP <= 0: return 0
    dResult = dB / (dA / dP - 1)
    return dCapR if dResult >= dCapR else dResult

# SSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSS
# StatLinInter: (Normalized) Stat Linear Interpolating

def StatLinInter(sPntMP, sProgScheme, sProgBase, sAdj, dLvl, vNorC, vRoundType = None):
    # parameter processing
    dN = 1; sC = ''
    if isinstance(vNorC, (int, float)):
        dN = vNorC
    elif isinstance(vNorC, str):
        sC = vNorC

    dProgScheme = CalcStat(sProgScheme, dLvl)
    dAccessLvls = dProgScheme[0]
    dBaseLvls = dProgScheme[1]

    # find interval points for requested level
    iHigh = 1
    iMax = len(dAccessLvls) - 1
    while iHigh < iMax and dLvl > dAccessLvls[iHigh]:
        iHigh += 1
    iLow = iHigh - 1

    dAccessLvlLow = dAccessLvls[iLow]
    dAccessLvlHigh = dAccessLvls[iHigh]

    if sProgBase:
        # get values from base progression if given
        dValLow = CalcStat(sProgBase, dBaseLvls[iLow], sC)
        dValHigh = CalcStat(sProgBase, dBaseLvls[iHigh], sC)
    else:
        # if not given: expect the base levels to contain the values directly
        dValLow = dBaseLvls[iLow]
        dValHigh = dBaseLvls[iHigh]

    # graph point multiplications
    if sPntMP:
        dValLow *= CalcStat(sPntMP, dAccessLvlLow, sC)
        dValHigh *= CalcStat(sPntMP, dAccessLvlHigh, sC)
    if sAdj:
        dValLow *= CalcStat(sAdj, dAccessLvlLow, sC)
        dValHigh *= CalcStat(sAdj, dAccessLvlHigh, sC)

    # return interpolated value from the calculated graph points
    return LinFmod(dN, dValLow, dValHigh, dAccessLvlLow, dAccessLvlHigh, dLvl, vRoundType)

# TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT
# LinFmod: Linear Interpolation function using 2 points with some optional modifications.
# Connects point (dLstart,dVal*dFstart) with (dLend,dVal*dFend).
# Usually used with dVal=1 and dFstart/dFend containing unrelated points or dVal=# and dFstart/dFend containing multiplier factors.
# Modification for points: rounding.

def LinFmod(dVal, dFstart, dFend, dLstart, dLend, dLvl, vRoundType = None):
    iRoundType = vRoundType if isinstance(vRoundType, (int, float)) else 0

    dVstart = dVal * dFstart
    dVend = dVal * dFend
    if iRoundType == 1: # Standard/Base Progressions
        dVstart = RoundDblProg(dVstart)
        dVend = RoundDblProg(dVend)
    elif iRoundType == 2: # Normalized Stat (by statpts) Progressions
        dVstart = RoundDblLotro(dVstart)
        dVend = RoundDblLotro(dVend)
    elif iRoundType == 3: # ICMR/NCMR (by statpts) Progressions
        dVstart = RoundDblMorReg(dVstart)
        dVend = RoundDblMorReg(dVend)

    # return point value directly if requested level is a low/high interval point
    if dLvl == dLstart: return dVstart
    if dLvl == dLend: return dVend

    if dLstart == dLend: return 0 # can't interpolate, return 0

    # return interpolated value from the calculated graph points
    return (dVstart * (dLend - dLvl) + (dLvl - dLstart) * dVend) / (dLend - dLstart)

# VVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVV
# TranslateValue: translates a value to an other by using a lookup table and a result table.
# If the value is not found in the lookup table then the function returns the default value, which is the last element in the result table.
# Object types allowed are both numbers (doubles, integers) and strings (non case sensitive matching) and may be mixed.

def TranslateValue(vSourceData, vResultData, vSearch):
    if isinstance(vSearch, (int, float)):
        for iSrc, vSrc in enumerate(vSourceData):
            if isinstance(vSrc, (int, float)) and vSrc == vSearch:
                return vResultData[iSrc]
    elif isinstance(vSearch, str):
        sSearch = vSearch.strip().upper()
        for iSrc, vSrc in enumerate(vSourceData):
            if isinstance(vSrc, str) and vSrc == sSearch:
                return vResultData[iSrc]

    return vResultData[-1] # return default value

# ****************** Parameter "C" decode support functions ******************

# ArmCodeIndex: returns a specified index from an Armour Code.
# sACode string:
# 1st position: H=heavy, M=medium, L=light
# 2nd position: H=head, S=shoulders, CL=cloak/back, C=chest, G=gloves, L=leggings, B=boots, Sh=shield
# 3rd position: W=white/common, Y=yellow/uncommon, P=purple/rare, T=teal/blue/incomparable, G=gold/legendary/epic
# Note: no such thing exists as a heavy, medium or light cloak, so no H/M/L in cloak codes (cloaks go automatically in the M class since U23, although historically this was L)

def ArmCodeIndex(sACode, iI):
    sArmCode = sACode.strip().upper()
    if not sArmCode: return 0

    # get positional codes and make some corrections
    sArmCat = sArmCode[0]
    sArmType = sArmCode[1] if len(sArmCode) > 1 else ''
    sArmCol = sArmCode[2] if len(sArmCode) > 2 else ''

    if sArmType == 'S' and sArmCol == 'H':
        sArmType = 'SH'
        sArmCol = sArmCode[3] if len(sArmCode) > 3 else ''
    elif sArmCat == 'C' and sArmType == 'L':
        sArmCat = 'M'
        sArmType = 'CL'
    else:
        sArmType = ' ' + sArmType

    if iI == 1:
        return 'HML'.find(sArmCat) + 1
    elif iI == 2:
        return ' H SCL C G L BSH'.find(sArmType) // 2 + 1
    elif iI == 3:
        return 'WYPTG'.find(sArmCol) + 1

    return 0

# EnumIndex: returns an index in a Enum string for a character at a specified index in a Code string
# returns 0 for unknown or missing character

def EnumIndex(sCodeChars, iCodeIndex, sEnumChars):
    sCode = sCodeChars.strip().upper()
    if not sCode: return 0 # no code given

    if 1 > iCodeIndex or iCodeIndex > len(sCode): return 0 # no character available for specified index
    sChar = sCode[iCodeIndex-1]

    return sEnumChars.find(sChar) + 1 # returns index of char in Enum string or 0 if not found

# RomanRankDecode: converts a string with a Roman number in characters, to an integer number.
# used for Legendary Item Title calculation.

sRomanRankChars = ("M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I")
iRomanRankValues = (1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1)

def RomanRankDecode(sRCode):
    sRomanCode = sRCode.strip().upper()
    if not sRomanCode: return 0

    iValue = 0

    C = 0
    iCodeLen = len(sRomanCode)
    while C < iCodeLen:
        iCharFound = None
        for I in range(13):
            iCharLen = 1 + (I % 2)
            if C + iCharLen <= iCodeLen and sRomanCode[C:C + iCharLen] == sRomanRankChars[I]:
                iCharFound = I
                break
        if iCharFound is None: break  # found unknown character: terminate
        iValue += iRomanRankValues[iCharFound]
        C += iCharLen

    return iValue

# ****************** Misc. floating point support functions ******************

# Misc. functions for floating point: rounding etc.
# For roundings: vDec is number of decimals.

# Floating point numbers bring errors into the calculation, both inside the Lotro-client and in this function collection. This is why a 100% match with the stats in Lotro is impossible.
# Anyway, to compensate for some errors, we use a calculation deviation correction value. This makes for instance 24.49999999 round to 25, as it's assumed that 24.5 was intended as outcome of a formula.
DblCalcDev = 1e-8
DblCorrDown = DblCalcDev
DblCorrNormal = 0.5 + DblCalcDev
DblCorrUp = 1 - DblCalcDev

def CorrectDbl(dNum, dCorrection, dDec):
    if dNum == 0: return dNum

    dSignedCorrection = -dCorrection if dNum < 0 else dCorrection

    if dDec == 0: return math.trunc(dNum + dSignedCorrection)

    dFactor = 10**dDec
    return math.trunc(dNum * dFactor + dSignedCorrection) / dFactor

def RoundDbl(dNum, vDec = 0):
    return CorrectDbl(dNum, DblCorrNormal, vDec)

def RoundDblDown(dNum, vDec = 0):
    return CorrectDbl(dNum, DblCorrDown, vDec)

def RoundDblUp(dNum, vDec = 0):
    return CorrectDbl(dNum, DblCorrUp, vDec)

def RoundDblLotro(dNum):
    if 0 > dNum >= -2: return -2
    dAbsNum = math.fabs(dNum)
    if dAbsNum <= 1000: return CorrectDbl(dNum, DblCorrUp, 0)
    return CorrectDbl(dNum, DblCorrUp, 2 - math.floor(math.log10(dAbsNum)))

def RoundDblMorReg(dNum):
    dAbsNum = math.fabs(dNum)
    if dAbsNum <= 100: return CorrectDbl(dNum, DblCorrUp, 2)
    if dAbsNum <= 1000: return CorrectDbl(dNum, DblCorrUp, 1)
    return CorrectDbl(dNum, DblCorrUp, 2 - math.floor(math.log10(dAbsNum)))

def RoundDblProg(dNum):
    if dNum == 0: return dNum
    return CorrectDbl(dNum, DblCorrNormal, 2 - math.floor(math.log10(math.fabs(dNum)) + 0.5))

# converts a double value into the equivalent of a single float value
def EquSng(vVal):
    return struct.unpack('>f', struct.pack('>f', vVal))[0]

# converts a double value into the decimal representation of an equivalent single float value
def DecSng(vVal):
    dVal = EquSng(vVal)
    if dVal == 0:
        # return 0 when 0
        return 0
    # calculate decimals interval for a max total of 8 digit precision
    # 0.09#######: 9 to 2
    # 0.9#######: 8 to 1
    # 9.#######: 7 to 0
    # 9#.######: 6 to -1
    # 9##.#####: 5 to -2 etc
    iDecMin = 8 - (math.floor(math.log10(math.fabs(dVal))) + 1)
    iDecMax = iDecMin - 7
    # result always needs to be rounded at least once, even if the result is not the same as the original equiv. float value
    dResult = CorrectDbl(dVal, DblCorrNormal, iDecMin)
    # search for the least number of decimals, while still keeping the same single value
    iDec = iDecMin - 1
    while iDec >= iDecMax:
        dTest = CorrectDbl(dVal, DblCorrNormal, iDec) # test value with ever less precision
        if dTest != dResult:
            if EquSng(dTest) == dVal:
                dResult = dTest
            else:
                # (test)value contains no longer the same single value
                break
        iDec = iDec - 1
    return dResult
