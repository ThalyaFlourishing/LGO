	// Support functions for CalcStat. These consist of implementations of more complex calculation types, decode methods for parameter "C" and rounding/min/max/compare functions for floating point numbers.

	// ****************** Calculation Type support functions ******************

	// DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD
	// DataTableValue: Takes a value from an array table.

	private static Object DataTableValue(Object[] oDataArray, int iIndex)
	{
		if (iIndex <= 1) return oDataArray[0];
		if (iIndex > oDataArray.length) return oDataArray[oDataArray.length-1];
		return oDataArray[iIndex-1];
	}
	
	// EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE
	// ExpFmod: Exponential function based on percentage.
	// Common percentage values are around ~5.5% for between levels and ~20% jumps between level segments.

	public static double ExpFmod(double dVal, int iLstart, double dPlvl, int iLvl)
	{
		return ExpFmod(dVal,iLstart,dPlvl,iLvl,0.0,-2147483648);
	}

	public static double ExpFmod(double dVal, int iLstart, double dPlvl, int iLvl, double dAdd)
	{
		return ExpFmod(dVal,iLstart,dPlvl,iLvl,dAdd,-2147483648);
	}

	public static double ExpFmod(double dVal, int iLstart, double dPlvl, int iLvl, double dAdd, int iDec)
	{
		int iRng = iLvl-iLstart+1;
		if (iRng <= 0) return dVal;
			
		double dFac = 1.0+dPlvl/100.0;

		if (iDec == -2147483648)
		{
			double dFacExp = Math.pow(dFac,iRng);
			return dVal*dFacExp+dAdd*((dFacExp-1.0)/(dFac-1.0));
		}

		double dResult = dVal;
		for (int iL = iLstart; iL <= iLvl; iL++)
			dResult = RoundDbl(dResult*dFac+dAdd,iDec);
		return dResult;
	}

	// IIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIII
	// LinInter: Linear Interpolation, given simple graph point data {{levels},{values}}

	public static double LinInter(int[] iLevels, double[] dValues, int iLvl)
	{
		// find interval points for requested level
		int iHigh = 1;
		int iMax = iLevels.length-1;
		while (iHigh < iMax && iLvl > iLevels[iHigh])
			iHigh++;
		int iLow = iHigh-1;
		
		// return interpolated value from the interval graph points
		return LinFmod(1.0,dValues[iLow],dValues[iHigh],iLevels[iLow],iLevels[iHigh],iLvl);
	}

	// PPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPP
	// CalcPercAB: Calculates the percentage out of a rating based on the AB formula.

	public static double CalcPercAB(double dA, double dB, double dPCap, double dR)
	{
		if (dR <= 0.0) return 0.0;
		double dResult = dA/(1.0+dB/dR);
		if (dResult >= dPCap) return dPCap;
		return dResult;
	}
	
	// RRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR
	// CalcRatAB: Calculates the rating out of a percentage based on the AB formula.

	public static double CalcRatAB(double dA, double dB, double dCapR, double dP)
	{
		if (dP <= 0.0) return 0.0;
		double dResult = dB/(dA/dP-1.0);
		if (dResult >= dCapR) return dCapR;
		return dResult;
	}

	// SSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSS
	// StatLinInter: (Normalized) Stat Linear Interpolating

	public static double StatLinInter(String sPntMP, String sProgScheme, String sProgBase, String sAdj, int iLvl, double dN, int iRoundType)
	{
		return StatLinInter(sPntMP,sProgScheme,sProgBase,sAdj,iLvl,dN,"",iRoundType);
	}

	public static double StatLinInter(String sPntMP, String sProgScheme, String sProgBase, String sAdj, int iLvl, double dN)
	{
		return StatLinInter(sPntMP,sProgScheme,sProgBase,sAdj,iLvl,dN,"",0);
	}

	public static double StatLinInter(String sPntMP, String sProgScheme, String sProgBase, String sAdj, int iLvl, String sC, int iRoundType)
	{
		return StatLinInter(sPntMP,sProgScheme,sProgBase,sAdj,iLvl,1.0,sC,iRoundType);
	}

	public static double StatLinInter(String sPntMP, String sProgScheme, String sProgBase, String sAdj, int iLvl, String sC)
	{
		return StatLinInter(sPntMP,sProgScheme,sProgBase,sAdj,iLvl,1.0,sC,0);
	}

	public static double StatLinInter(String sPntMP, String sProgScheme, String sProgBase, String sAdj, int iLvl, double dN, String sC, int iRoundType)
	{
		// parameter processing
		int[][] iProgScheme = (int[][])CalcStat(sProgScheme,iLvl);
		int[] iAccessLvls = iProgScheme[0];
		int[] iBaseLvls = iProgScheme[1];

		// find interval points for requested level
		int iHigh = 1;
		int iMax = iAccessLvls.length-1;
		while (iHigh < iMax && iLvl > iAccessLvls[iHigh])
			iHigh++;
		int iLow = iHigh-1;

		int iAccessLvlLow = iAccessLvls[iLow];
		int iAccessLvlHigh = iAccessLvls[iHigh];

		// get values from base progression
		double dValLow = (double)CalcStat(sProgBase,iBaseLvls[iLow],sC);
		double dValHigh = (double)CalcStat(sProgBase,iBaseLvls[iHigh],sC);

		// graph point multiplications
		if (!sPntMP.isBlank())
		{
			dValLow *= (double)CalcStat(sPntMP,iAccessLvlLow,sC);
			dValHigh *= (double)CalcStat(sPntMP,iAccessLvlHigh,sC);
		}
		if (!sAdj.isBlank())
		{
			dValLow *= (double)CalcStat(sAdj,iAccessLvlLow,sC);
			dValHigh *= (double)CalcStat(sAdj,iAccessLvlHigh,sC);
		}

		// return interpolated value from the calculated graph points
		return LinFmod(dN,dValLow,dValHigh,iAccessLvlLow,iAccessLvlHigh,iLvl,iRoundType);
	}

	// TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT
	// LinFmod: Linear line function between 2 points with some optional modifications.
	// Connects point (dLstart,dVal*dFstart) with (dLend,dVal*dFend).
	// Usually used with dVal=1 and dFstart/dFend containing unrelated points or dVal=# and dFstart/dFend containing multiplier factors.
	// Modification for points: rounding.

	public static double LinFmod(double dVal, double dFstart, double dFend, int iLstart, int iLend, int iLvl)
	{
		return LinFmod(dVal,dFstart,dFend,iLstart,iLend,iLvl,0);
	}

	public static double LinFmod(double dVal, double dFstart, double dFend, int iLstart, int iLend, int iLvl, int iRoundType)
	{
		// finalize interval values: multiply base Value by Factor and apply rounding by requested type
		double dVstart = dVal*dFstart; double dVend = dVal*dFend;
		if (iRoundType != 0)
			switch (iRoundType)
			{
				case 1 -> {dVstart = RoundDblProg(dVstart); dVend = RoundDblProg(dVend);}
				case 2 -> {dVstart = RoundDblLotro(dVstart); dVend = RoundDblLotro(dVend);}
				case 3 -> {dVstart = RoundDblMorReg(dVstart); dVend = RoundDblMorReg(dVend);}
			}

		// return point value directly if requested level is a low/high interval point
		if (iLvl == iLstart) return dVstart;
		if (iLvl == iLend) return dVend;
		
		if (iLstart == iLend) return 0.0; // can't interpolate, return 0

		// return interpolated value from the calculated graph points
		return (dVstart*(iLend-iLvl)+(iLvl-iLstart)*dVend)/(iLend-iLstart);
	}

	// VVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVV
	// TranslateValue: translates a value to an other by using a lookup table and a result table.
	// If the value is not found in the lookup table then the function returns the default value, which is the last element in the result table.
	// Object types allowed are both numbers (doubles, ints) and strings (non case sensitive matching) and may be mixed.

	public static Object TranslateValue(Object[] oSourceData, Object[] oResultData, Object oSearch)
	{
		if (oSearch instanceof String) oSearch = ((String) oSearch).trim().toUpperCase();

		for (int iSrc = 0; iSrc < oSourceData.length; iSrc++)
			if (Objects.equals(oSourceData[iSrc],oSearch))
				return oResultData[iSrc];

		return oResultData[oResultData.length-1]; // return default value
	}

	// ****************** Parameter "C" decode support functions ******************

	// ArmCodeIndex: returns a specified index from an Armour Code.
	// sACode string:
	// 1st position: H=heavy, M=medium, L=light
	// 2nd position: H=head, S=shoulders, CL=cloak/back, C=chest, G=gloves, L=leggings, B=boots, Sh=shield
	// 3rd position: W=white/common, Y=yellow/uncommon, P=purple/rare, T=teal/blue/incomparable, G=gold/legendary/epic
	// Note: no such thing exists as a heavy, medium or light cloak, so no H/M/L in cloak codes (cloaks go automatically in the M class since U23, although historically this was L)

	public static int ArmCodeIndex(String sACode, int iI)
	{
		String sArmCode = sACode.trim();
		if (sArmCode.isBlank()) return 0;
		sArmCode = sArmCode.toUpperCase()+"    ";

		String sArmCat = sArmCode.substring(0,1);
		String sArmType = sArmCode.substring(1,2);
		String sArmCol = sArmCode.substring(2,3);

		if (sArmType.compareTo("S") == 0 && sArmCol.compareTo("H") == 0)
		{
			sArmType = "SH";
			sArmCol = sArmCode.substring(3,4);
		}
		else if (sArmCat.compareTo("C") == 0 && sArmType.compareTo("L") == 0)
		{
			sArmCat = "M";
			sArmType = "CL";
		}
		else
			sArmType = " "+sArmType;
				
		if (iI == 1)
			return "HML".indexOf(sArmCat)+1;
		else if (iI == 2)
			return " H SCL C G L BSH".indexOf(sArmType)/2+1;
		else if (iI == 3)
			return "WYPTG".indexOf(sArmCol)+1;
		else
			return 0;
	}

	// EnumIndex: returns an index in a Enum string for a character at a specified index in a Code string
	// returns 0 for unknown or missing character
	
	public static int EnumIndex(String sCodeChars, int iCodeIndex, String sEnumChars)
	{
		String sCode = sCodeChars.trim();
		if (sCode.isBlank()) return 0; // no code given
		sCode = sCode.toUpperCase();
		if (1 > iCodeIndex || iCodeIndex > sCode.length()) return 0; // no character available for specified index
		String sChar = sCode.substring(iCodeIndex-1,iCodeIndex);
		return sEnumChars.indexOf(sChar)+1; // returns index of char in Enum string or 0 if not found
	}

	// RomanRankDecode: converts a string with a Roman number in characters, to an int number.
	// used for Legendary Item Title calculation.

	private static final String[] sRomanRankChars = {"M","CM","D","CD","C","XC","L","XL","X","IX","V","IV","I"};
	private static final int[] iRomanRankValues = {1000,900,500,400,100,90,50,40,10,9,5,4,1};

	public static int RomanRankDecode(String sRCode)
	{
		String sRomanCode = sRCode.trim();
		if (sRomanCode.isBlank()) return 0;
		sRomanCode = sRomanCode.toUpperCase();

		int iValue = 0;
		
		int iCharFound;
		int iCharLen = 0;

		int C = 0;
		int iCodeLen = sRomanCode.length();
		while (C < iCodeLen)
		{
			iCharFound = -1;
			for (int I = 0; I <= 12; I++)
			{
				iCharLen = 1+I%2;
				if (C+iCharLen <= iCodeLen && sRomanCode.substring(C,C+iCharLen).contentEquals(sRomanRankChars[I]))
				{
					iCharFound = I;
					break;
				}
			}
			if (iCharFound == -1) break; // found unknown character: terminate
			iValue += iRomanRankValues[iCharFound];
			C += iCharLen;
		}
		
		return iValue;
	}
	
	// ****************** Misc. floating point support functions ******************

	// Misc. functions for floating point rounding.
	// 2nd parameter is number of decimals.

	// Floating point numbers bring errors into the calculation, both inside the Lotro-client and in this function collection. This is why a 100% match with the stats in Lotro is impossible.
	// Anyway, to compensate for some errors, we use a calculation deviation correction value. This makes for instance 24.49999999 round to 25, as it's assumed that 24.5 was intended as outcome of a formula.
	private static final double DblCalcDev = 1e-8;
	private static final double DblCorrDown = DblCalcDev;
	private static final double DblCorrNormal = 0.5+DblCalcDev;
	private static final double DblCorrUp = 1.0-DblCalcDev;

	private static final double[] DblPow10 = {1e1,1e2,1e3,1e4,1e5,1e6,1e7,1e8,1e9,1e10}; // 1-10 decimals
	
	private static int CorrectDbl(double dNum, double dCorrection)
	{
		if (dNum == 0.0) return 0;

		double dSignedCorrection;
		if (dNum < 0.0) dSignedCorrection = -dCorrection; else dSignedCorrection = dCorrection;
		
		return (int)(dNum+dSignedCorrection);
	}
	
	private static double CorrectDbl(double dNum, double dCorrection, int iDec)
	{
		if (dNum == 0.0) return 0.0;

		double dSignedCorrection;
		if (dNum < 0.0) dSignedCorrection = -dCorrection; else dSignedCorrection = dCorrection;
		
		if (iDec == 0) return (int)(dNum+dSignedCorrection);

		double dFactor;
		if (iDec > 0)
		{
			dFactor = DblPow10[iDec-1];
			return ((int)(dNum*dFactor+dSignedCorrection))/dFactor;
		}
		else
		{
			dFactor = DblPow10[-iDec-1];
			return ((int)(dNum/dFactor+dSignedCorrection))*dFactor;
		}
	}
	
	public static int RoundDbl(double dNum)
	{
		return CorrectDbl(dNum,DblCorrNormal);
	}
	
	public static double RoundDbl(double dNum, int iDec)
	{
		return CorrectDbl(dNum,DblCorrNormal,iDec);
	}

	public static int RoundDblDown(double dNum)
	{
		return CorrectDbl(dNum,DblCorrDown);
	}
	
	public static double RoundDblDown(double dNum, int iDec)
	{
		return CorrectDbl(dNum,DblCorrDown,iDec);
	}

	public static int RoundDblUp(double dNum)
	{
		return CorrectDbl(dNum,DblCorrUp);
	}
	
	public static double RoundDblUp(double dNum, int iDec)
	{
		return CorrectDbl(dNum,DblCorrUp,iDec);
	}

	public static double RoundDblLotro(double dNum)
	{
		if (dNum < 0.0 && dNum > -2.0) return -2.0;
		double dAbsNum = Math.abs(dNum);
		if (dAbsNum <= 1000.0) return CorrectDbl(dNum,DblCorrUp,0);
		return CorrectDbl(dNum,DblCorrUp,2-(int)Math.floor(Math.log10(dAbsNum)));
	}

	public static double RoundDblMorReg(double dNum)
	{
		double dAbsNum = Math.abs(dNum);
		if (dAbsNum <= 100.0) return CorrectDbl(dNum,DblCorrUp,2);
		if (dAbsNum <= 1000.0) return CorrectDbl(dNum,DblCorrUp,1);
		return CorrectDbl(dNum,DblCorrUp,2-(int)Math.floor(Math.log10(dAbsNum)));
	}

	public static double RoundDblProg(double dNum)
	{
		if (dNum == 0.0) return dNum;
		return CorrectDbl(dNum,DblCorrNormal,2-(int)Math.floor(Math.log10(Math.abs(dNum))+0.5));
	}

	// converts a int value into the equivalent of a single float value
	public static double EquSng(int iNum)
	{
		return (float)iNum;
	}
	
	// converts a double value into the equivalent of a single float value
	public static double EquSng(double dNum)
	{
		return (float)dNum;
	}
	
	// converts a int value into the decimal representation of an equivalent single float value
	public static double DecSng(int iNum)
	{
		return EquSng(iNum);
	}
	
	// converts a double value into the decimal representation of an equivalent single float value
	public static double DecSng(double dNum)
	{
		double dVal = EquSng(dNum);
		if (dVal == 0.0) return 0.0; // return 0 when 0

		// calculate decimals interval for a max total of 8 digit precision
		// 0.09#######: 9 to 2
		// 0.9#######: 8 to 1
		// 9.#######: 7 to 0
		// 9#.######: 6 to -1
		// 9##.#####: 5 to -2 etc
		int iDecMin = 8-((int)Math.floor(Math.log10(Math.abs(dVal)))+1);
		int iDecMax = iDecMin-7;
		
		// result always needs to be rounded at least once, even if the result is not the same as the original equiv. float value
		double dResult = CorrectDbl(dVal,DblCorrNormal,iDecMin);
		
		double dTest;
		for (int iDec = iDecMin-1; iDec >= iDecMax; iDec = iDec-1)
		{
			dTest = CorrectDbl(dVal,DblCorrNormal,iDec); // test value with ever less precision
			if (dTest != dResult)
			{
				if (EquSng(dTest) == dVal)
					dResult = dTest;
				else
					// (test)value contains no longer the same single value
					break;
			}
		}
		
		return dResult;
	}

	public static void main(String[] args)
	{
		System.out.println("CalcStat version: "+calcstat.CalcStat("-Version"));
	}
}
