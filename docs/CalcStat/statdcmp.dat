// Created by Giseldah

function CalcStat(SName, SLvl, SParam)
{
	const SN = SName.trim().toUpperCase();
	const L = SLvl;
	let N = 1.0;
	let C = "";
	if (typeof SParam !== "undefined") {
		if (typeof SParam === "number")
			N = SParam;
		else if (typeof SParam === "string")
			C = SParam;
	}

	let Result = 0.0;

