# Created by Giseldah

import math
import struct

def CalcStat(SName, SLvl, SParam = None):
    SN = SName.strip().upper()
    L = SLvl
    N = 1; C = ''
    if isinstance(SParam, (int, float)):
        N = SParam
    elif isinstance(SParam, str):
        C = SParam
 
    Result = 0

