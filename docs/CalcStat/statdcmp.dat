' Created by Giseldah

Function CalcStat(ByVal SName, ByVal SLvl, ByVal SParam)

	Dim SN: SN = UCase(Trim(SName))
	Dim L: L = SLvl
	Dim N: N = 1.0
	Dim C: C = ""
